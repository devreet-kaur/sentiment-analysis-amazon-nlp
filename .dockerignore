# .dockerignore - exclude everything not needed at runtime

# Data files (never in Docker image)
data/
*.csv

# Model files now baked into image, no longer excluded
mlruns/
logs/

# Notebooks
notebooks/

# Tests (not needed at runtime)
tests/

# DVC files
.dvc/
*.dvc
dvc.lock

# Git
.git/
.gitignore

# Environment
.env
.venv
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Reports
reports/

# IDE
.vscode/
.idea/
