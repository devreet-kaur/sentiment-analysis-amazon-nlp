# .gitignore - MAI203 Amazon Fine Food Reviews NLP Pipeline
# Finalized on Day 1. Do not modify after the first PR.

# ── Data files (tracked by DVC, not Git) ─────────────────────────────────────

data/raw/*.csv
data/raw/*.sqlite
data/processed/*.csv
*.tsv
*.parquet

# ── Model checkpoints (too large for Git) ────────────────────────────────────
results/models/
*.pkl
*.pt
*.pth
*.bin
*.onnx
*.h5

# ── Experiment tracking ───────────────────────────────────────────────────────
mlruns/
mlartifacts/
wandb/

# ── DVC internals (dvc.lock IS committed) ─────────────────────────────────────
.dvc/tmp/
.dvc/cache/

# ── Inference logs ────────────────────────────────────────────────────────────
logs/

# ── API keys and secrets ──────────────────────────────────────────────────────
.env
.env.*
*.key
secrets.yaml

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.Python
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Jupyter notebooks (output stripped by pre-commit) ────────────────────────
.ipynb_checkpoints/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
